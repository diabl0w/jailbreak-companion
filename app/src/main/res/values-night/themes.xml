<resources>
    <style name="Theme.JBCompanion" parent="android:Theme.Material">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:colorPrimary">#B8924A</item>
        <item name="android:colorAccent">#B8924A</item>
        <item name="android:colorButtonNormal">@color/btn_background_color</item>
        <item name="android:buttonCornerRadius">24dp</item>
        <item name="android:buttonStyle">@style/Widget.JBCompanion.Button</item>
    </style>

    <style name="Widget.JBCompanion.Button" parent="android:Widget.Material.Button">
        <item name="android:textColor">@color/btn_text_color</item>
    </style>
</resources>
